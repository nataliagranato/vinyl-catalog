meta {
  name: Create Track
  type: http
  seq: 12
}

post {
  url: {{base_url}}/api/{{api_version}}/vinyls/{{vinyl_id}}/tracks
  body: {
    title: "Speak to Me",
    duration: "1:30",
    side: "A"
  }
  auth: bearer {{jwt_token}}
}

body:json {
  "description": "Add a new track to a vinyl record",
  "authentication": "Required",
  "params": {
    "vinyl_id": "UUID of the vinyl record"
  },
  "required_fields": ["title"]
}

tests {
  test("Creates track successfully", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body).to.have.property("title", "Speak to Me");
  });
}
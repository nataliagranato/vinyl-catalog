meta {
  name: Get All Vinyls
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/{{api_version}}/vinyls
  auth: bearer {{jwt_token}}
}

body:json {
  "description": "Retrieve a list of all vinyl records in the catalog",
  "authentication": "Required"
}

tests {
  test("Returns array of vinyls", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("array");
  });
}
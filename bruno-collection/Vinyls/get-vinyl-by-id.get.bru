meta {
  name: Get Vinyl by ID
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/{{api_version}}/vinyls/{{vinyl_id}}
  auth: bearer {{jwt_token}}
}

body:json {
  "description": "Retrieve a specific vinyl record by its unique identifier",
  "authentication": "Required",
  "params": {
    "vinyl_id": "UUID of the vinyl record"
  }
}

tests {
  test("Returns vinyl details", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body).to.have.property("title");
  });
}
meta {
  name: Create Vinyl
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/{{api_version}}/vinyls
  body: {
    title: "Dark Side of the Moon",
    artist: "Pink Floyd",
    year: 1973,
    genre: "Progressive Rock",
    label: "Harvest",
    description: "One of the most influential albums of all time"
  }
  auth: bearer {{jwt_token}}
}

body:json {
  "description": "Create a new vinyl record in the catalog",
  "authentication": "Required",
  "required_fields": ["title", "artist", "year", "genre"]
}

tests {
  test("Creates vinyl successfully", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body).to.have.property("title", "Dark Side of the Moon");
  });
}
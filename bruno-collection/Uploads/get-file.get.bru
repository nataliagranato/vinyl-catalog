meta {
  name: Get Uploaded File
  type: http
  seq: 19
}

get {
  url: {{base_url}}/uploads/{{filename}}
  auth: none
}

body:json {
  "description": "Serve uploaded files from R2 storage",
  "authentication": "Not required - Public endpoint",
  "params": {
    "filename": "Name of the uploaded file"
  }
}
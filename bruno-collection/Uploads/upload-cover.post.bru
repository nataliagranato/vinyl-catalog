meta {
  name: Upload Cover Image
  type: http
  seq: 18
}

post {
  url: {{base_url}}/api/{{api_version}}/vinyls/{{vinyl_id}}/cover
  body: multipart
  files: [
    {
      name: "cover",
      file: "path/to/cover.jpg"
    }
  ]
  auth: bearer {{jwt_token}}
}

body:json {
  "description": "Upload a cover image for a vinyl record",
  "authentication": "Required",
  "params": {
    "vinyl_id": "UUID of the vinyl record"
  },
  "notes": "Replace 'path/to/cover.jpg' with actual file path"
}